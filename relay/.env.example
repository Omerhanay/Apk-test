# Copy to .env (never commit it). Values here are placeholders.
# Anthropic API key, read by the SDK from the environment.
ANTHROPIC_API_KEY=
# SHA-256 (hex) of the device token. Generate:
#   TOKEN=$(openssl rand -hex 32); echo "$TOKEN"   # paste into the app once
#   printf %s "$TOKEN" | sha256sum | cut -d' ' -f1  # put this here
RELAY_TOKEN_SHA256=
# anthropic | mock (mock = simulated responses for development only)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5
LLM_EFFORT=high
PORT=8787
